# Copy this file to .env before running `docker compose up`.
# .env is gitignored — never commit real secrets.
#
# POSTGRES_* are optional (default to "ranking"/"ranking") so plain `docker compose up -d`
# works with zero config for local development. RANKING_JWT_SECRET and RANKING_ADMIN_PASSWORD
# are REQUIRED to start the `app` service (compose fails fast with a clear error if missing) —
# always set real values for those two before a real deployment.

# PostgreSQL
POSTGRES_DB=ranking
POSTGRES_USER=ranking
POSTGRES_PASSWORD=changeme-postgres-password
# Host port Postgres is published on (only matters if something on the host, e.g. `./gradlew
# bootRun` or a DB client, needs to reach it directly at localhost:PORT)
POSTGRES_PORT=5432

# Host port the app is published on (http://localhost:APP_PORT)
APP_PORT=8080

# JWT signing secret. MUST be a long random string in any real deployment.
# Generate one with PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# or with Git Bash / OpenSSL:
#   openssl rand -base64 48
RANKING_JWT_SECRET=changeme-generate-a-long-random-secret

# Default admin account, auto-seeded on first startup only. Log in and change
# the password immediately after the first deploy.
RANKING_ADMIN_USERNAME=admin
RANKING_ADMIN_PASSWORD=changeme-admin-password
